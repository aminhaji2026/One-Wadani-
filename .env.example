DATABASE_URL="postgresql://waddani:waddani@localhost:5432/waddani?schema=public"
# Use a long random string in every shared or production environment.
JWT_SECRET="change-me-in-production-use-a-long-random-string"
API_PORT=4000
# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:5173,http://localhost:8080"
VITE_API_URL="http://localhost:4000/api"
PUBLIC_APP_URL="http://localhost:5173"
NODE_ENV="development"
# Optional: required for mock payment webhooks outside development.
MOCK_WEBHOOK_SECRET=""

# Seed controls (entrypoint on Railway)
# RUN_SEED=true runs scripts/seed.ts after migrate. Prefer once per env, then false.
RUN_SEED="false"
# SEED_RESET_PASSWORDS=true forces seed accounts back to ChangeMe123! — leave false in production.
SEED_RESET_PASSWORDS="false"

# Optional SMTP for registration, password reset, and donation receipts.
# Without these, emails are logged to the API console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Waddani One <noreply@waddani.local>"

# ZAAD
ZAAD_BASE_URL="https://api.zaad.net"
ZAAD_MERCHANT_ID=""
ZAAD_API_KEY=""
ZAAD_WEBHOOK_SECRET=""

# eDahab
EDAHAB_BASE_URL="https://edahab.net/api"
EDAHAB_MERCHANT_ID=""
EDAHAB_API_KEY=""
EDAHAB_WEBHOOK_SECRET=""

# Premier Wallet
PREMIER_BASE_URL="https://api.premierwallet.example"
PREMIER_MERCHANT_ID=""
PREMIER_API_KEY=""
PREMIER_WEBHOOK_SECRET=""

# MyCash
MYCASH_BASE_URL="https://api.mycash.example"
MYCASH_MERCHANT_ID=""
MYCASH_API_KEY=""
MYCASH_WEBHOOK_SECRET=""

# Sifalo
SIFALO_BASE_URL="https://api.sifalo.example"
SIFALO_MERCHANT_ID=""
SIFALO_API_KEY=""
SIFALO_WEBHOOK_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
